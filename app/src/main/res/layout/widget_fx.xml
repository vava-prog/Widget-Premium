<?xml version="1.0" encoding="utf-8"?>
<!--
    Lớp hiệu ứng thời tiết phủ lên nền widget. Mỗi ProgressBar mang một AnimatedVectorDrawable hữu hạn:
    launcher tự chạy hoạt ảnh mỗi khi view hiện ra (ví dụ vuốt tới trang có widget), hết giờ thì đứng yên.
    Chỉ một ProgressBar được hiện (xem WidgetMotion); các cái còn lại GONE nên không chạy.
    indeterminateOnly=false để vector kéo giãn vừa khung thay vì giữ tỉ lệ.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fx_box"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <ProgressBar
        android:id="@+id/fx_sun"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/fx_sun"
        android:indeterminateOnly="false"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/fx_stars"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/fx_stars"
        android:indeterminateOnly="false"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/fx_clouds"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/fx_clouds"
        android:indeterminateOnly="false"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/fx_rain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/fx_rain"
        android:indeterminateOnly="false"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/fx_storm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/fx_storm"
        android:indeterminateOnly="false"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/fx_snow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/fx_snow"
        android:indeterminateOnly="false"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/fx_fog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/fx_fog"
        android:indeterminateOnly="false"
        android:visibility="gone" />

</FrameLayout>
