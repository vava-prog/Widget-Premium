<?xml version="1.0" encoding="utf-8"?>
<!-- Sinh tự động bởi tools/gen_weather_fx.py, không sửa tay. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="60000"
    android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="1" />
        <keyframe
            android:fraction="0.11753"
            android:value="1" />
        <keyframe
            android:fraction="0.14511"
            android:value="0"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.17321"
            android:value="0" />
        <keyframe
            android:fraction="0.22785"
            android:value="1"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="1"
            android:value="1" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="1" />
        <keyframe
            android:fraction="0.11753"
            android:value="1" />
        <keyframe
            android:fraction="0.14511"
            android:value="0"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.17321"
            android:value="0" />
        <keyframe
            android:fraction="0.22785"
            android:value="1"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="1"
            android:value="1" />
    </propertyValuesHolder>
</objectAnimator>
