<?xml version="1.0" encoding="utf-8"?>
<!-- Sinh tự động bởi tools/gen_weather_fx.py, không sửa tay. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="4000"
    android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder
        android:propertyName="translateX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.4175"
            android:value="0" />
        <keyframe
            android:fraction="0.49925"
            android:value="0.41"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.5195"
            android:value="0.51"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="1"
            android:value="0.51" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="translateY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.4175"
            android:value="0" />
        <keyframe
            android:fraction="0.49925"
            android:value="22.2"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.5195"
            android:value="27.75"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="1"
            android:value="27.75" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.215"
            android:value="0" />
        <keyframe
            android:fraction="0.295"
            android:value="0.92"
            android:interpolator="@interpolator/fx_pop" />
        <keyframe
            android:fraction="0.3675"
            android:value="0.92" />
        <keyframe
            android:fraction="0.4175"
            android:value="0.83"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.5195"
            android:value="0.74" />
        <keyframe
            android:fraction="0.5995"
            android:value="0.83"
            android:interpolator="@interpolator/fx_pop" />
        <keyframe
            android:fraction="1"
            android:value="0.83" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.215"
            android:value="0" />
        <keyframe
            android:fraction="0.295"
            android:value="0.92"
            android:interpolator="@interpolator/fx_pop" />
        <keyframe
            android:fraction="0.3675"
            android:value="0.92" />
        <keyframe
            android:fraction="0.4175"
            android:value="1.12"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.5195"
            android:value="1.01" />
        <keyframe
            android:fraction="0.5995"
            android:value="0.83"
            android:interpolator="@interpolator/fx_pop" />
        <keyframe
            android:fraction="1"
            android:value="0.83" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.3675"
            android:value="0" />
        <keyframe
            android:fraction="0.4175"
            android:value="-1.05"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="1"
            android:value="-1.05" />
    </propertyValuesHolder>
</objectAnimator>
