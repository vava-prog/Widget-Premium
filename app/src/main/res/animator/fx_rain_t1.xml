<?xml version="1.0" encoding="utf-8"?>
<!-- Sinh tự động bởi tools/gen_weather_fx.py, không sửa tay. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="60000"
    android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder
        android:propertyName="translateX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="translateY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.08608"
            android:value="1" />
        <keyframe
            android:fraction="0.14933"
            android:value="1" />
        <keyframe
            android:fraction="0.2136"
            android:value="0"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.09108"
            android:value="0" />
        <keyframe
            android:fraction="0.09958"
            android:value="0.19"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.1017"
            android:value="0.24"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="0.12673"
            android:value="0.24" />
        <keyframe
            android:fraction="0.13585"
            android:value="0.47"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.13812"
            android:value="0.52"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="0.2136"
            android:value="0.52" />
        <keyframe
            android:fraction="0.21527"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="-4.81" />
        <keyframe
            android:fraction="1"
            android:value="-4.81" />
    </propertyValuesHolder>
</objectAnimator>
