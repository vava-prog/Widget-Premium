<?xml version="1.0" encoding="utf-8"?>
<!-- Sinh tự động bởi tools/gen_weather_fx.py, không sửa tay. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="60000"
    android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder
        android:propertyName="translateX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="translateY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.17802"
            android:value="1" />
        <keyframe
            android:fraction="0.2783"
            android:value="1" />
        <keyframe
            android:fraction="0.331"
            android:value="0"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.18302"
            android:value="0" />
        <keyframe
            android:fraction="0.19165"
            android:value="0.17"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.1938"
            android:value="0.22"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="0.2154"
            android:value="0.22" />
        <keyframe
            android:fraction="0.22423"
            android:value="0.4"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.22643"
            android:value="0.45"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="0.25142"
            android:value="0.45" />
        <keyframe
            android:fraction="0.25795"
            android:value="0.55"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.25958"
            android:value="0.57"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="0.331"
            android:value="0.57" />
        <keyframe
            android:fraction="0.33267"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="-3.99" />
        <keyframe
            android:fraction="1"
            android:value="-3.99" />
    </propertyValuesHolder>
</objectAnimator>
