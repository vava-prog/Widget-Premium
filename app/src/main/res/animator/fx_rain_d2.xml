<?xml version="1.0" encoding="utf-8"?>
<!-- Sinh tự động bởi tools/gen_weather_fx.py, không sửa tay. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="60000"
    android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder
        android:propertyName="translateX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.30433"
            android:value="0" />
        <keyframe
            android:fraction="0.31857"
            android:value="-0.62"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.32212"
            android:value="-0.78"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="0.47948"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="translateY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.30433"
            android:value="0" />
        <keyframe
            android:fraction="0.31857"
            android:value="34.83"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.32212"
            android:value="43.54"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="0.47948"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="1" />
        <keyframe
            android:fraction="0.30033"
            android:value="1" />
        <keyframe
            android:fraction="0.30433"
            android:value="0.9"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.32212"
            android:value="0.81" />
        <keyframe
            android:fraction="0.32845"
            android:value="0.9"
            android:interpolator="@interpolator/fx_pop" />
        <keyframe
            android:fraction="0.37485"
            android:value="0.9" />
        <keyframe
            android:fraction="0.41548"
            android:value="0"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.48115"
            android:value="0" />
        <keyframe
            android:fraction="0.48815"
            android:value="1"
            android:interpolator="@interpolator/fx_pop" />
        <keyframe
            android:fraction="1"
            android:value="1" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="1" />
        <keyframe
            android:fraction="0.30033"
            android:value="1" />
        <keyframe
            android:fraction="0.30433"
            android:value="1.22"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.32212"
            android:value="1.1" />
        <keyframe
            android:fraction="0.32845"
            android:value="0.9"
            android:interpolator="@interpolator/fx_pop" />
        <keyframe
            android:fraction="0.37485"
            android:value="0.9" />
        <keyframe
            android:fraction="0.41548"
            android:value="0"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.48115"
            android:value="0" />
        <keyframe
            android:fraction="0.48815"
            android:value="1"
            android:interpolator="@interpolator/fx_pop" />
        <keyframe
            android:fraction="1"
            android:value="1" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.30033"
            android:value="0" />
        <keyframe
            android:fraction="0.30433"
            android:value="1.02"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.47948"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
</objectAnimator>
