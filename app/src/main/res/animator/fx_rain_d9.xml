<?xml version="1.0" encoding="utf-8"?>
<!-- Sinh tự động bởi tools/gen_weather_fx.py, không sửa tay. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="4000"
    android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder
        android:propertyName="translateX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.08725"
            android:value="0" />
        <keyframe
            android:fraction="0.16775"
            android:value="0.13"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.18775"
            android:value="0.16"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="1"
            android:value="0.16" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="translateY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.08725"
            android:value="0" />
        <keyframe
            android:fraction="0.16775"
            android:value="17.6"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.18775"
            android:value="22"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="1"
            android:value="22" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="1" />
        <keyframe
            android:fraction="0.03725"
            android:value="1" />
        <keyframe
            android:fraction="0.08725"
            android:value="0.9"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.18775"
            android:value="0.81" />
        <keyframe
            android:fraction="0.26775"
            android:value="0.9"
            android:interpolator="@interpolator/fx_pop" />
        <keyframe
            android:fraction="1"
            android:value="0.9" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="1" />
        <keyframe
            android:fraction="0.03725"
            android:value="1" />
        <keyframe
            android:fraction="0.08725"
            android:value="1.22"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.18775"
            android:value="1.1" />
        <keyframe
            android:fraction="0.26775"
            android:value="0.9"
            android:interpolator="@interpolator/fx_pop" />
        <keyframe
            android:fraction="1"
            android:value="0.9" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.03725"
            android:value="0" />
        <keyframe
            android:fraction="0.08725"
            android:value="-0.42"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="1"
            android:value="-0.42" />
    </propertyValuesHolder>
</objectAnimator>
