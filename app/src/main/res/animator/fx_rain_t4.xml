<?xml version="1.0" encoding="utf-8"?>
<!-- Sinh tự động bởi tools/gen_weather_fx.py, không sửa tay. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="60000"
    android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder
        android:propertyName="translateX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="translateY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.25588"
            android:value="1" />
        <keyframe
            android:fraction="0.31302"
            android:value="1" />
        <keyframe
            android:fraction="0.37273"
            android:value="0"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.26088"
            android:value="0" />
        <keyframe
            android:fraction="0.26972"
            android:value="0.21"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.27192"
            android:value="0.26"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="0.29037"
            android:value="0.26" />
        <keyframe
            android:fraction="0.29902"
            android:value="0.47"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.30117"
            android:value="0.52"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="0.37273"
            android:value="0.52" />
        <keyframe
            android:fraction="0.3744"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="4.76" />
        <keyframe
            android:fraction="1"
            android:value="4.76" />
    </propertyValuesHolder>
</objectAnimator>
