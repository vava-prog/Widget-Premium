<?xml version="1.0" encoding="utf-8"?>
<!-- Sinh tự động bởi tools/gen_weather_fx.py, không sửa tay. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="4000"
    android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder
        android:propertyName="translateX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="translateY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.41925"
            android:value="0" />
        <keyframe
            android:fraction="0.44425"
            android:value="1" />
        <keyframe
            android:fraction="1"
            android:value="1" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.44425"
            android:value="0" />
        <keyframe
            android:fraction="0.5495"
            android:value="0.43"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.57575"
            android:value="0.54"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="1"
            android:value="0.54" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="-3.54" />
        <keyframe
            android:fraction="1"
            android:value="-3.54" />
    </propertyValuesHolder>
</objectAnimator>
