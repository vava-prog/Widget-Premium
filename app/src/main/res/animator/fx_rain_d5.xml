<?xml version="1.0" encoding="utf-8"?>
<!-- Sinh tự động bởi tools/gen_weather_fx.py, không sửa tay. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="60000"
    android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder
        android:propertyName="translateX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.35417"
            android:value="0" />
        <keyframe
            android:fraction="0.3645"
            android:value="-1.4"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.36708"
            android:value="-1.75"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="0.49778"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="translateY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.35417"
            android:value="0" />
        <keyframe
            android:fraction="0.3645"
            android:value="22.38"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.36708"
            android:value="27.97"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="0.49778"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="1" />
        <keyframe
            android:fraction="0.35017"
            android:value="1" />
        <keyframe
            android:fraction="0.35417"
            android:value="0.9"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.36708"
            android:value="0.81" />
        <keyframe
            android:fraction="0.37342"
            android:value="0.9"
            android:interpolator="@interpolator/fx_pop" />
        <keyframe
            android:fraction="0.41938"
            android:value="0.9" />
        <keyframe
            android:fraction="0.462"
            android:value="0"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.49945"
            android:value="0" />
        <keyframe
            android:fraction="0.50645"
            android:value="1"
            android:interpolator="@interpolator/fx_pop" />
        <keyframe
            android:fraction="1"
            android:value="1" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="1" />
        <keyframe
            android:fraction="0.35017"
            android:value="1" />
        <keyframe
            android:fraction="0.35417"
            android:value="1.22"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.36708"
            android:value="1.1" />
        <keyframe
            android:fraction="0.37342"
            android:value="0.9"
            android:interpolator="@interpolator/fx_pop" />
        <keyframe
            android:fraction="0.41938"
            android:value="0.9" />
        <keyframe
            android:fraction="0.462"
            android:value="0"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.49945"
            android:value="0" />
        <keyframe
            android:fraction="0.50645"
            android:value="1"
            android:interpolator="@interpolator/fx_pop" />
        <keyframe
            android:fraction="1"
            android:value="1" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.35017"
            android:value="0" />
        <keyframe
            android:fraction="0.35417"
            android:value="3.58"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.49778"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
</objectAnimator>
