<?xml version="1.0" encoding="utf-8"?>
<!-- Sinh tự động bởi tools/gen_weather_fx.py, không sửa tay. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="4000"
    android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder
        android:propertyName="translateX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.44425"
            android:value="0" />
        <keyframe
            android:fraction="0.5495"
            android:value="2.12"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.57575"
            android:value="2.65"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="1"
            android:value="2.65" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="translateY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.44425"
            android:value="0" />
        <keyframe
            android:fraction="0.5495"
            android:value="34.33"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.57575"
            android:value="42.92"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="1"
            android:value="42.92" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="1" />
        <keyframe
            android:fraction="0.39425"
            android:value="1" />
        <keyframe
            android:fraction="0.44425"
            android:value="0.9"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.57575"
            android:value="0.81" />
        <keyframe
            android:fraction="0.65575"
            android:value="0.9"
            android:interpolator="@interpolator/fx_pop" />
        <keyframe
            android:fraction="1"
            android:value="0.9" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="1" />
        <keyframe
            android:fraction="0.39425"
            android:value="1" />
        <keyframe
            android:fraction="0.44425"
            android:value="1.22"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="0.57575"
            android:value="1.1" />
        <keyframe
            android:fraction="0.65575"
            android:value="0.9"
            android:interpolator="@interpolator/fx_pop" />
        <keyframe
            android:fraction="1"
            android:value="0.9" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.39425"
            android:value="0" />
        <keyframe
            android:fraction="0.44425"
            android:value="-3.54"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="1"
            android:value="-3.54" />
    </propertyValuesHolder>
</objectAnimator>
