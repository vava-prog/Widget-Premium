<?xml version="1.0" encoding="utf-8"?>
<!-- Sinh tự động bởi tools/gen_weather_fx.py, không sửa tay. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="4000"
    android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder
        android:propertyName="translateX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="translateY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.52925"
            android:value="0" />
        <keyframe
            android:fraction="0.55425"
            android:value="0.99" />
        <keyframe
            android:fraction="1"
            android:value="0.99" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.55425"
            android:value="0" />
        <keyframe
            android:fraction="0.64075"
            android:value="0.22"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.66225"
            android:value="0.27"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="0.791"
            android:value="0.27" />
        <keyframe
            android:fraction="0.86775"
            android:value="0.44"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.88675"
            android:value="0.48"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="1"
            android:value="0.48" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="3.56" />
        <keyframe
            android:fraction="1"
            android:value="3.56" />
    </propertyValuesHolder>
</objectAnimator>
