<?xml version="1.0" encoding="utf-8"?>
<!-- Sinh tự động bởi tools/gen_weather_fx.py, không sửa tay. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="60000"
    android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder
        android:propertyName="translateX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="translateY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.05503"
            android:value="1" />
        <keyframe
            android:fraction="0.1109"
            android:value="1" />
        <keyframe
            android:fraction="0.16453"
            android:value="0"
            android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.06003"
            android:value="0" />
        <keyframe
            android:fraction="0.06903"
            android:value="0.2"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.07128"
            android:value="0.24"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="0.08693"
            android:value="0.24" />
        <keyframe
            android:fraction="0.09508"
            android:value="0.4"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.09712"
            android:value="0.44"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="0.16453"
            android:value="0.44" />
        <keyframe
            android:fraction="0.1662"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="-4.34" />
        <keyframe
            android:fraction="1"
            android:value="-4.34" />
    </propertyValuesHolder>
</objectAnimator>
