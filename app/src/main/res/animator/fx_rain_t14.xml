<?xml version="1.0" encoding="utf-8"?>
<!-- Sinh tự động bởi tools/gen_weather_fx.py, không sửa tay. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="4000"
    android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder
        android:propertyName="translateX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="translateY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.37775"
            android:value="0" />
        <keyframe
            android:fraction="0.40275"
            android:value="1" />
        <keyframe
            android:fraction="1"
            android:value="1" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.40275"
            android:value="0" />
        <keyframe
            android:fraction="0.47425"
            android:value="0.19"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.492"
            android:value="0.24"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="0.5985"
            android:value="0.24" />
        <keyframe
            android:fraction="0.66425"
            android:value="0.41"
            android:interpolator="@interpolator/fx_fall" />
        <keyframe
            android:fraction="0.6805"
            android:value="0.45"
            android:interpolator="@interpolator/fx_brake" />
        <keyframe
            android:fraction="1"
            android:value="0.45" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <keyframe
            android:fraction="0"
            android:value="-3.14" />
        <keyframe
            android:fraction="1"
            android:value="-3.14" />
    </propertyValuesHolder>
</objectAnimator>
