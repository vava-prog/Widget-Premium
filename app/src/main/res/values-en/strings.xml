    <string name="add_widget_unsupported">Your launcher does not support quick add. Add the widget manually using the steps below.</string>
    <string name="guide_title">How to add the widget manually</string>
    <string name="guide_step1">Touch and hold an empty spot on the home screen.</string>
    <string name="guide_step2">Choose Widgets, then find Widget Premium.</string>
    <string name="guide_step3">Drag the widget onto the home screen and drag its edges to resize.</string>
